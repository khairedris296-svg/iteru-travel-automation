    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const requestData = $('HTTP Request1').item.json;\nconst place = (requestData && requestData.places && requestData.places.length > 0) ? requestData.places[0] : null;\n\n// سحب اسم المدينة و الـ POI من عقدة الشيت\nconst cityName = $('Get row(s) in sheet1').item.json[\"destination\"]; \nconst poiName = $('Get row(s) in sheet1').item.json[\"POI\"]; \n\nreturn {\n    cityName: cityName || \"N/A\",\n    POI: poiName || \"N/A\",\n    hotelLat: place && place.location ? place.location.latitude : null,\n    hotelLng: place && place.location ? place.location.longitude : null\n};"
      },
