{
  "name": "We reach agent Hotels sites",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst formattedHotels = items.map(item => {\n    const row = item.json;\n    \n    let lat = null;\n    let lng = null;\n    const coordStr = row['coordinations'] || row['Coordinates'] || \"\";\n    \n    if (coordStr) {\n        // استخراج الأرقام فقط (بما في ذلك الفواصل العشرية والسالب) وتجاهل الحروف\n        const matches = coordStr.match(/-?\\d+(\\.\\d+)?/g);\n        if (matches && matches.length >= 2) {\n            lat = parseFloat(matches[0]);\n            lng = parseFloat(matches[1]);\n        }\n    }\n\n    // استخراج رابط الحجز ومعالجته بذكاء\n    let rawUrl = (row['Distance'] || row['distance'] || \"\").trim();\n    let formattedUrl = \"#\";\n\n    if (rawUrl) {\n        if (rawUrl.startsWith(\"http://\") || rawUrl.startsWith(\"https://\")) {\n            formattedUrl = rawUrl;\n        } else if (rawUrl.startsWith(\"/\")) {\n            formattedUrl = \"https://www.google.com\" + rawUrl;\n        } else if (rawUrl.includes(\" \") || !rawUrl.includes(\".\")) {\n            // إذا كان النص يحتوي على مسافات (مثل 6.32 km)، فهو ليس رابطاً!\n            // نصنع رابط بحث في جوجل كبديل ذكي\n            const searchQ = encodeURIComponent((row['hotel name'] || \"\") + \" hotel booking\");\n            formattedUrl = \"https://www.google.com/search?q=\" + searchQ;\n        } else {\n            formattedUrl = \"https://\" + rawUrl;\n        }\n    }\n    \n    return {\n        json: {\n            row_number: row['row_number'] || row['rowNumber'] || \"\", // 👈 هذا هو السطر المضاف\n            timestamp: row['date'] || \"\",\n            website: row['website'] || \"Unknown\", \n            'hotel name': row['hotel name'] || \"Unknown Hotel\",\n            price: row['price'] || \"0\",\n            'stars rate': row['stars rate'] || \"3\",\n            \n            // إرسال الرابط الأصلي والرابط المعالج للداشبورد\n            'Distance': rawUrl,\n            'booking_url': formattedUrl,\n            \n            // تمرير الإحداثيات النظيفة للداشبورد\n            lat: isNaN(lat) ? null : lat,\n            lng: isNaN(lng) ? null : lng,\n            coordinations: coordStr,\n            \n            // الخانات المتبقية\n            'Distance22': row['POI Distance22'] || row['Distance22'] || \"\",\n            'Distance to city center': row['Distance to city center'] || \"\",\n            'More details': row['More details'] || \"\",\n            'Location': row['Location'] || row['location'] || \"\",\n            'Img link': row['Img link'] || row['img link'] || \"\"\n        }\n    };\n});\n\nreturn formattedHotels;"
      },
