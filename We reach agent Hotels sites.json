    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. استدعاء الأسماء من عقدة الاستخراج\nconst cityName = $('Extract city and hotel coordinates').item.json.cityName || \"the city\";\nconst poiName = $('Extract city and hotel coordinates').item.json.POI || \"the POI\";\n\n// 2. استدعاء إحداثيات الفندق\nconst hotelLat = $('Extract city and hotel coordinates').item.json.hotelLat;\nconst hotelLng = $('Extract city and hotel coordinates').item.json.hotelLng;\n\n// 3. استدعاء إحداثيات المدينة (من عقدة Request city coords)\nconst cityData = $('Request city coords').item.json;\nconst cityLat = (cityData && cityData.places && cityData.places.length > 0) ? cityData.places[0].location.latitude : null;\nconst cityLng = (cityData && cityData.places && cityData.places.length > 0) ? cityData.places[0].location.longitude : null;\n\n// 4. استدعاء إحداثيات الـ POI (من العقدة الحالية المدخلة Request POI coords)\nconst poiData = $json;\nconst poiLat = (poiData && poiData.places && poiData.places.length > 0) ? poiData.places[0].location.latitude : null;\nconst poiLng = (poiData && poiData.places && poiData.places.length > 0) ? poiData.places[0].location.longitude : null;\n\n// 5. دالة رياضية لحساب المسافة بالكيلومتر\nfunction calculateDistance(lat1, lon1, lat2, lon2) {\n    if (!lat1 || !lon1 || !lat2 || !lon2) return null;\n    const R = 6371; // نصف قطر الأرض بالكيلومتر\n    const dLat = (lat2 - lat1) * (Math.PI / 180);\n    const dLon = (lon2 - lon1) * (Math.PI / 180);\n    const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +\n              Math.cos(lat1 * (Math.PI / 180)) * Math.cos(lat2 * (Math.PI / 180)) *\n              Math.sin(dLon / 2) * Math.sin(dLon / 2);\n    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\n    return R * c;\n}\n\n// حد أقصى صارم للمسافة المنطقية 10 كم\nconst MAX_REASONABLE_DIST = 10; \n\n// 6. تنفيذ الحساب\nconst distToCity = calculateDistance(hotelLat, hotelLng, cityLat, cityLng);\nconst distToPOI = calculateDistance(hotelLat, hotelLng, poiLat, poiLng);\n\n// 7. تنسيق النصوص النهائية\nlet distanceCityStr;\nlet distancePoiStr;\n\n// التحقق من حالة البحث المخصص باسم الفندق (عدم توفر اسم منطقة/POI)\nconst isSpecificHotelSearch = (!poiName || String(poiName).trim().toUpperCase() === \"N/A\" || String(poiName).trim() === \"\");\n\nif (isSpecificHotelSearch) {\n    // أ- خانة البعد عن الـ POI تصبح دائماً الجملة التالية\n    distancePoiStr = \"Specific Hotel Search\";\n\n    // ب- خانة البعد عن المدينة يتم فيها تطبيق قاعدة الـ 10 كم\n    if (distToCity !== null) {\n        if (distToCity <= MAX_REASONABLE_DIST) {\n            distanceCityStr = distToCity.toFixed(2) + \" km to \" + cityName + \" city center\";\n        } else {\n            // قمنا بتغيير km إلى Kilometers لكي لا يقوم الداشبورد بقص الجملة\ndistanceCityStr = \"+10 Kilometers to \" + cityName + \" city center\";\n        }\n    } else {\n        distanceCityStr = \"N/A\";\n    }\n\n} else {\n    // ج- حالة البحث الطبيعي (يوجد اسم منطقة فعلي)\n    distanceCityStr = (distToCity !== null && distToCity <= MAX_REASONABLE_DIST) \n        ? distToCity.toFixed(2) + \" km to \" + cityName + \" city center\" \n        : \"N/A\";\n\n    distancePoiStr = (distToPOI !== null && distToPOI <= MAX_REASONABLE_DIST) \n        ? distToPOI.toFixed(2) + \" km to \" + poiName \n        : \"N/A\";\n}\n\n// 8. تحديد الفنادق الخاطئة لإرسال أمر الحذف\nlet shouldDelete = false;\n\n// إذا كان هناك اسم منطقة (ليس بحثاً مخصصاً)، وإحدى المسافتين تحولت إلى N/A (تجاوزت 10 كم)\nif (!isSpecificHotelSearch && (distanceCityStr === \"N/A\" || distancePoiStr === \"N/A\")) {\n    shouldDelete = true;\n}\n\n// إخراج النتائج للداشبورد مع مؤشر الحذف\nreturn {\n    distanceToCityCenter: distanceCityStr,\n    distanceToPOI: distancePoiStr,\n    shouldDelete: shouldDelete\n};"
      },
